# "mock" = in-browser fake data (Phase 0). "http" = real Spring Boot API (Phase 1+).
VITE_API_MODE=mock
# Used only when VITE_API_MODE=http. The dev server proxies /api to localhost:8080.
VITE_API_BASE_URL=/api/v1
# Artificial delay for mock responses, in ms, so loading states are visible.
VITE_MOCK_DELAY_MS=350
# Mock mode only: how often the chat/notification poller checks for new events, in ms.
VITE_REALTIME_POLL_MS=3000
